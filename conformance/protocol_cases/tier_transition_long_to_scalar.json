{
  "name": "tier transition long -> scalar (every live cell closed, new tier starts at its own v1)",
  "key": [20, 30, 40],
  "steps": [
    {
      "op": { "long": { "start": 0, "step": 1, "length": 3, "cells": [ { "pos": 0, "value": 10.0 }, { "pos": 2, "value": 30.0 } ] } },
      "expect": {
        "long": [
          { "i1_pos": 0, "version": 1, "valid_to_step": null, "retained": true, "v_float": 10.0 },
          { "i1_pos": 2, "version": 1, "valid_to_step": null, "retained": true, "v_float": 30.0 }
        ]
      }
    },
    {
      "op": { "long": { "start": 0, "step": 1, "length": 3, "cells": [ { "pos": 0, "value": 11.0 }, { "pos": 1, "value": 20.0 } ] } },
      "expect": {
        "long": [
          { "i1_pos": 0, "version": 1, "valid_to_step": 2, "retained": true, "v_float": 10.0 },
          { "i1_pos": 1, "version": 1, "valid_to_step": null, "retained": true, "v_float": 20.0 },
          { "i1_pos": 2, "version": 1, "valid_to_step": 2, "retained": true, "v_float": 30.0 },
          { "i1_pos": 0, "version": 2, "valid_to_step": null, "retained": true, "v_float": 11.0 }
        ]
      }
    },
    {
      "op": { "scalar_float": { "v": 5.0 } },
      "expect": {
        "scalar": [
          { "version": 1, "valid_to_step": null, "retained": true, "v_float": 5.0 }
        ],
        "long": [
          { "i1_pos": 0, "version": 1, "valid_to_step": 2, "retained": true, "v_float": 10.0 },
          { "i1_pos": 1, "version": 1, "valid_to_step": 3, "retained": true, "v_float": 20.0 },
          { "i1_pos": 2, "version": 1, "valid_to_step": 2, "retained": true, "v_float": 30.0 },
          { "i1_pos": 0, "version": 2, "valid_to_step": 3, "retained": true, "v_float": 11.0 }
        ],
        "array": [],
        "array_hist": []
      }
    }
  ]
}
