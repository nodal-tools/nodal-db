{
  "name": "long value moved to another axis with the same cell payloads is a whole-value rewrite",
  "key": [21, 31, 41],
  "steps": [
    {
      "op": { "long": { "start": 0, "step": 1, "length": 3, "cells": [ { "pos": 0, "value": 10.0 }, { "pos": 2, "value": 30.0 } ] } },
      "expect": {
        "long": [
          { "i1_pos": 0, "version": 1, "valid_to_step": null, "retained": true, "v_float": 10.0 },
          { "i1_pos": 2, "version": 1, "valid_to_step": null, "retained": true, "v_float": 30.0 }
        ]
      }
    },
    {
      "op": { "long": { "start": 1, "step": 1, "length": 3, "cells": [ { "pos": 0, "value": 10.0 }, { "pos": 2, "value": 30.0 } ] } },
      "expect": {
        "long": [
          { "i1_pos": 0, "version": 1, "valid_to_step": 2, "retained": true, "v_float": 10.0 },
          { "i1_pos": 2, "version": 1, "valid_to_step": 2, "retained": true, "v_float": 30.0 },
          { "i1_pos": 0, "version": 2, "valid_to_step": null, "retained": true, "v_float": 10.0 },
          { "i1_pos": 2, "version": 2, "valid_to_step": null, "retained": true, "v_float": 30.0 }
        ]
      }
    }
  ]
}
