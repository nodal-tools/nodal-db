{
  "name": "force_replace writes a retention stub (content_retained = FALSE, payload nulled)",
  "key": [15, 25, 35],
  "steps": [
    {
      "op": { "scalar_float": { "v": 3.0 } },
      "expect": {
        "scalar": [
          { "version": 1, "valid_to_step": null, "retained": true, "v_float": 3.0 }
        ]
      }
    },
    {
      "op": { "scalar_float": { "v": 4.0 } },
      "force_replace": true,
      "expect": {
        "scalar": [
          { "version": 1, "valid_to_step": 2, "retained": false, "v_float": null },
          { "version": 2, "valid_to_step": null, "retained": true, "v_float": 4.0 }
        ]
      }
    }
  ]
}
